# Publish only the deliverables: notebooks, code, figures, README,
# requirements and the official user guide. Everything else stays local
# (data, models, logs, reports, scripts and tests).
/*
!/.gitignore
!/README.md
!/requirements.txt
!/0*_*.ipynb
!/images/
!/src/
!/Data/

# Data folder: only the CDC user guide; raw data and archives stay local.
/Data/*
!/Data/UserGuide2024.pdf

# Never publish credentials, even inside an allowed folder.
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json
service_account*.json

# Caches.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
